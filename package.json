{
  "name": "hermes-t3sidebar",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register-loader.mjs --test tests/*.test.mjs",
    "test:backend": "python -W error::ResourceWarning -m unittest discover -s tests -v",
    "test:all": "npm test && npm run test:backend && npm run test:browser",
    "test:browser": "node tests/browser-smoke.mjs",
    "harness:build": "node harness/build.mjs",
    "harness": "node harness/build.mjs && node harness/serve.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.90.5",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
