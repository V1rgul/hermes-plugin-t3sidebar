{
  "name": "hermes-t3sidebar",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register-loader.mjs --test tests/*.test.mjs",
    "test:backend": "python -W error::ResourceWarning -c \"import hermes_bootstrap, unittest; unittest.main(module=None)\" discover -s tests -v",
    "test:all": "concurrently --success all --names frontend,backend,browser --prefix name \"npm:test\" \"npm:test:backend\" \"npm:test:browser\"",
    "test:browser": "node tests/browser-smoke.mjs",
    "perf": "node tests/perf/browser-bench.mjs",
    "perf:backend": "python -W error::ResourceWarning tests/perf/backend_bench.py",
    "perf:all": "npm run perf && npm run perf:backend",
    "harness:build": "node harness/build.mjs",
    "harness": "node harness/build.mjs && node harness/serve.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.90.5",
    "@vscode/codicons": "0.0.45",
    "concurrently": "9.2.5",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
